<?xml version="1.0"?>
<robot name="two_wheel_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:include filename="$(find robot_description)/urdf/robot_description.gazebo"/>

  <!-- Chassis -->
  <xacro:property name="base_length"   value="0.30"/>
  <xacro:property name="base_width"    value="0.22"/>
  <xacro:property name="base_height"   value="0.10"/>
  <xacro:property name="base_mass"     value="2.5"/>

  <!-- Wheels -->
  <xacro:property name="wheel_radius"  value="0.06"/>
  <xacro:property name="wheel_width"   value="0.04"/>
  <xacro:property name="wheel_mass"    value="0.25"/>
  <xacro:property name="wheel_gap"     value="0.005"/>

  <!-- Caster wheel (rear, ball caster) -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.06"/>
  <xacro:property name="caster_x"      value="-0.12"/>

  <!-- Ground clearance = wheel radius, since base_link sits at wheel-center height -->
  <xacro:property name="base_z"        value="${wheel_radius}"/>

  <!-- Sensors -->
  <xacro:property name="lidar_mass"        value="0.19"/>
  <xacro:property name="lidar_radius"      value="0.038"/>
  <xacro:property name="lidar_height"      value="0.045"/>
  <xacro:property name="lidar_mesh_scale"  value="1 1 1"/>
  <xacro:property name="lidar_stand_h"     value="0.03"/>
  <xacro:property name="roof_thickness"    value="0.02"/>

  <xacro:property name="camera_mass"       value="0.16"/>
  <xacro:property name="camera_x_size"     value="0.03"/>
  <xacro:property name="camera_y_size"     value="0.175"/>
  <xacro:property name="camera_z_size"     value="0.03"/>
  <xacro:property name="camera_mesh_scale" value="0.001 0.001 0.001"/>

  <xacro:property name="PI" value="3.14159265"/>

  <!-- MATERIALS -->
  <material name="body_blue">   <color rgba="0.30 0.70 0.95 1.0"/></material>
  <material name="cream_white"> <color rgba="0.97 0.97 0.94 1.0"/></material>
  <material name="soft_black">  <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="tire_dark">   <color rgba="0.15 0.15 0.17 1.0"/></material>
  <material name="hub_white">   <color rgba="0.95 0.95 0.95 1.0"/></material>
  <material name="sun_yellow">  <color rgba="1.00 0.80 0.10 1.0"/></material>
  <material name="caster_grey"> <color rgba="0.55 0.55 0.58 1.0"/></material>
  <material name="lidar_black"> <color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="cam_black">   <color rgba="0.08 0.08 0.08 1.0"/></material>

  <!-- INERTIA MACROS -->
  <xacro:macro name="box_inertial" params="mass x y z ox:=0 oy:=0 oz:=0">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12)*mass*(y*y+z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12)*mass*(x*x+z*z)}" iyz="0.0"
               izz="${(1/12)*mass*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass r h ox:=0 oy:=0 oz:=0">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12)*mass*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12)*mass*(3*r*r+h*h)}" iyz="0.0"
               izz="${0.5*mass*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass r ox:=0 oy:=0 oz:=0">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${(2/5)*mass*r*r}" ixy="0.0" ixz="0.0"
               iyy="${(2/5)*mass*r*r}" iyz="0.0"
               izz="${(2/5)*mass*r*r}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>


  <link name="base_link">
    <!-- main rounded body -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>

    <!-- rounded tail (rear) -->
    <visual>
      <origin xyz="${-base_length/2 - 0.005} 0 0.02" rpy="0 1.5708 0"/>
      <geometry>
        <sphere radius="${base_height/2 - 0.005}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>

    <!-- flat roof plate on top of the body (cute, but flat as requested) -->
    <visual>
      <origin xyz="0 0 ${base_height/2 + 0.02 + roof_thickness/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length*0.92} ${base_width*0.92} ${roof_thickness}"/>
      </geometry>
      <material name="cream_white"/>
    </visual>

    <!-- two cute "eyes" on the front edge of the roof -->
    <visual>
      <origin xyz="${base_length/2 - 0.035} 0.06 ${base_height/2 + 0.02 + roof_thickness}" rpy="0 0 0"/>
      <geometry><sphere radius="0.014"/></geometry>
      <material name="soft_black"/>
    </visual>
    <visual>
      <origin xyz="${base_length/2 - 0.035} -0.06 ${base_height/2 + 0.02 + roof_thickness}" rpy="0 0 0"/>
      <geometry><sphere radius="0.014"/></geometry>
      <material name="soft_black"/>
    </visual>

    <!-- small antenna, tucked in the rear-corner of the roof -->
    <visual>
      <origin xyz="${-base_length/2 + 0.04} 0.07 ${base_height/2 + 0.02 + roof_thickness + 0.03}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.06"/></geometry>
      <material name="soft_black"/>
    </visual>
    <visual>
      <origin xyz="${-base_length/2 + 0.04} 0.07 ${base_height/2 + 0.02 + roof_thickness + 0.06}" rpy="0 0 0"/>
      <geometry><sphere radius="0.012"/></geometry>
      <material name="sun_yellow"/>
    </visual>

    <!-- ===== Collision: single box matching the physical body (main shell + roof
         plate). Decorative details (eyes, antenna, tail sphere) are intentionally
         left out of collision - they're too small/thin to matter for physics and
         would only add unnecessary collision checks. ===== -->
    <collision>
      <origin xyz="0 0 ${0.02 + roof_thickness/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height + roof_thickness}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="${base_mass}" x="${base_length}" y="${base_width}"
                         z="${base_height + roof_thickness}" oz="${0.02 + roof_thickness/2}"/>
  </link>

  <!-- WHEEL MACRO -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tire_dark"/>
      </visual>
      <!-- hub cap detail -->
      <visual>
        <origin xyz="0 ${reflect*(wheel_width/2 + 0.001)} 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius*0.35}" length="0.002"/>
        </geometry>
        <material name="hub_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="0.08 ${reflect*(base_width/2 + wheel_width/2 + wheel_gap)} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.15" friction="0.05"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- CASTER WHEEL -->
  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertial mass="${caster_mass}" r="${caster_radius}"/>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>


  <!-- LIDAR : RPLIDAR A1M8-R6
       lidar_link's own frame is now the sensor's frame: visual, collision, and
       inertial all sit at "0 0 0" inside it. The entire real-world position
       (including the fine alignment the mesh needed) lives in lidar_joint below,
       so the three representations can never drift apart again.
       NOTE: the "-0.0936" term is the same fine-tuned mesh-alignment offset that
       previously lived on the visual's <origin>, just moved up into the joint.
       Since we don't have the STL's native origin documented, re-check this in
       RViz - if the mesh needs a nudge, adjust lidar_joint's xyz/rpy only (never
       the individual visual/collision/inertial origins), so all three stay locked
       together. -->
  <link name="lidar_link">
    <visual>
      <!-- mesh-only alignment fix (STL's native axes don't match Z-up) -->
      <origin xyz="0 0.1 -0.0936" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/lidar.STL" scale="${lidar_mesh_scale}"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <!-- our own primitive: axis is genuinely vertical, no mesh quirk to compensate for -->
      <origin xyz="0 0.1 -0.0936" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}" ox="0" oy="0.1" oz="-0.0936"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <!-- back to position-only: lidar_link stays Z-up, matching what the sensor expects -->
    <origin xyz="0 0 ${base_height/2 + 0.05 + roof_thickness + lidar_stand_h}" rpy="0 0 0"/>
  </joint>


  <!-- CAMERA : ZED -->
  <link name="zed_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/zed.STL" scale="${camera_mesh_scale}"/>
      </geometry>
      <material name="cam_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_x_size} ${camera_y_size} ${camera_z_size}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="${camera_mass}" x="${camera_x_size}" y="${camera_y_size}" z="${camera_z_size}"/>
  </link>

  <joint name="zed_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="zed_camera_link"/>
    <!-- mounted at the front of the mobile robot, looking forward -->
    <origin xyz="${base_length/2 + 0.016} 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- standard frame for camera optical convention -->
  <link name="zed_camera_optical_frame"/>
  <joint name="zed_camera_optical_joint" type="fixed">
    <parent link="zed_camera_link"/>
    <child  link="zed_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

</robot>